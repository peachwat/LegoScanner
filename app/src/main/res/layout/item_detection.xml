<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="vertical"
              android:paddingStart="16dp"
              android:paddingTop="8dp"
              android:paddingEnd="16dp"
              android:paddingBottom="8dp">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

        <ImageView
                android:id="@+id/detectionImage"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/part_image_description"
                android:scaleType="fitCenter"/>

        <View
                android:id="@+id/sampledColorDot"
                android:layout_width="8dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"/>

        <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

            <TextView
                    android:id="@+id/detectionName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

            <TextView
                    android:id="@+id/detectionMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:alpha="0.7"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"/>

            <View
                    android:id="@+id/confidenceBar"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_marginTop="5dp"/>

        </LinearLayout>

        <TextView
                android:id="@+id/detectionConfidence"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:gravity="end"
                android:minWidth="52dp"
                android:textSize="15sp"
                android:textStyle="bold"/>

    </LinearLayout>

    <LinearLayout
            android:id="@+id/reviewButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:visibility="gone">

        <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textSize="12sp"
                android:text="@string/review_confirm"/>

        <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCorrect"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:text="@string/review_correct"/>

    </LinearLayout>

</LinearLayout>
